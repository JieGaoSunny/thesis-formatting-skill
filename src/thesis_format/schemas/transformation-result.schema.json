{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-format.example/schemas/v1/transformation-result.schema.json",
  "title": "Thesis transformation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_path",
    "source_sha256",
    "output_path",
    "output_sha256",
    "changes",
    "post_audit",
    "content_comparison"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "output_path": {"type": "string", "minLength": 1},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    },
    "post_audit": {"$ref": "#/$defs/audit"},
    "content_comparison": {"$ref": "#/$defs/contentComparison"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}(?:[0-9a-f]{4}){0,12}$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[A-Z]+(?:\\.[A-Z0-9_]+)+$"
    },
    "location": {
      "type": "string",
      "pattern": "^(?:document|(?:section|paragraph|table|header|footer):[1-9][0-9]*|cell:[1-9][0-9]*/[1-9][0-9]*/[1-9][0-9]*|part:.+)$"
    },
    "jsonValue": {
      "type": ["array", "boolean", "null", "number", "object", "string"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "violations", "warnings"],
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "violations": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id",
        "severity",
        "location",
        "message",
        "repairable",
        "repaired",
        "before",
        "after"
      ],
      "properties": {
        "finding_id": {"$ref": "#/$defs/stableId"},
        "rule_id": {"$ref": "#/$defs/ruleId"},
        "severity": {"enum": ["error", "violation", "warning"]},
        "location": {"$ref": "#/$defs/location"},
        "message": {"type": "string", "minLength": 1},
        "repairable": {"type": "boolean"},
        "repaired": {"type": "boolean"},
        "before": {"$ref": "#/$defs/jsonValue"},
        "after": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool_version",
        "created_at",
        "document_sha256",
        "input",
        "profile",
        "summary",
        "findings"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "tool_version": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "input": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "summary": {"$ref": "#/$defs/summary"},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "rule_id",
        "location",
        "operation",
        "before",
        "after",
        "status"
      ],
      "properties": {
        "change_id": {"$ref": "#/$defs/stableId"},
        "rule_id": {"$ref": "#/$defs/ruleId"},
        "location": {"$ref": "#/$defs/location"},
        "operation": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1},
        "relationship_sha256": {"$ref": "#/$defs/sha256"},
        "object_occurrence_sha256": {"$ref": "#/$defs/sha256"},
        "before": {"$ref": "#/$defs/jsonValue"},
        "after": {"$ref": "#/$defs/jsonValue"},
        "status": {"enum": ["applied", "skipped", "failed"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"operation": {"const": "move_caption"}},
            "required": ["operation"]
          },
          "then": {
            "required": [
              "node_id",
              "object_occurrence_sha256",
              "before",
              "after"
            ],
            "properties": {
              "rule_id": {
                "enum": ["FIGURE.CAPTION.POSITION", "TABLE.CAPTION.POSITION"]
              },
              "before": {
                "$ref": "#/$defs/captionBinding"
              },
              "after": {
                "$ref": "#/$defs/captionBinding"
              }
            }
          }
        }
      ]
    },
    "captionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "object_occurrence_sha256",
        "position"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "object_occurrence_sha256": {"$ref": "#/$defs/sha256"},
        "position": {"enum": ["above", "below"]}
      }
    },
    "contentComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_snapshot_sha256",
        "after_snapshot_sha256",
        "equivalent",
        "differences"
      ],
      "properties": {
        "before_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "after_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "equivalent": {"type": "boolean"},
        "differences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "node_id", "before", "after"],
            "properties": {
              "kind": {"enum": ["added", "removed", "changed", "reordered"]},
              "node_id": {"type": "string", "minLength": 1},
              "before": {"$ref": "#/$defs/jsonValue"},
              "after": {"$ref": "#/$defs/jsonValue"}
            }
          }
        }
      }
    }
  }
}
