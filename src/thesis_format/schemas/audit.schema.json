{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-format.example/schemas/v1/audit.schema.json",
  "title": "Thesis audit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "document_sha256", "profile_id", "findings", "summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"$ref": "#/$defs/stableId"},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "warning", "info"],
      "properties": {
        "error": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[0-9a-f]{16}(?:[0-9a-f]{4}){0,12}$"},
    "jsonValue": {"type": ["array", "boolean", "null", "number", "object", "string"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "path", "index", "page"],
      "properties": {
        "part": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "page": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "source"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "node_type": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "dataField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "rule_id", "severity", "location", "message", "before", "after", "data"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/stableId"},
        "rule_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "location": {"$ref": "#/$defs/location"},
        "message": {"type": "string", "minLength": 1},
        "before": {"$ref": "#/$defs/jsonValue"},
        "after": {"$ref": "#/$defs/jsonValue"},
        "data": {"type": "array", "items": {"$ref": "#/$defs/dataField"}}
      }
    }
  }
}
