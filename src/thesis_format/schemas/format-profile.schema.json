{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-format.example/schemas/v1/format-profile.schema.json",
  "title": "Thesis format profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "metadata",
    "page",
    "styles",
    "role_detection",
    "numbering",
    "front_matter",
    "fields",
    "headers_footers",
    "figures",
    "tables",
    "references",
    "privacy"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "schema_version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "schema_version": {"const": "1.0"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1000},
          "uniqueItems": true
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "body",
        "header_distance_mm",
        "footer_distance_mm",
        "section_start"
      ],
      "properties": {
        "paper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_mm", "height_mm"],
          "properties": {
            "width_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
            "height_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_mm", "bottom_mm", "left_mm", "right_mm"],
          "properties": {
            "top_mm": {"type": "number", "minimum": 0, "maximum": 500},
            "bottom_mm": {"type": "number", "minimum": 0, "maximum": 500},
            "left_mm": {"type": "number", "minimum": 0, "maximum": 500},
            "right_mm": {"type": "number", "minimum": 0, "maximum": 500}
          }
        },
        "header_distance_mm": {"type": "number", "minimum": 0, "maximum": 100},
        "footer_distance_mm": {"type": "number", "minimum": 0, "maximum": 100},
        "section_start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "major_back_matter"],
          "properties": {
            "body": {"enum": ["next_page", "odd_page", "continuous"]},
            "major_back_matter": {
              "enum": ["next_page", "odd_page", "continuous"]
            }
          }
        }
      }
    },
    "styles": {"$ref": "#/$defs/styleRoles"},
    "role_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_patterns", "position_constraints"],
      "properties": {
        "text_patterns": {"$ref": "#/$defs/textPatternRoles"},
        "position_constraints": {"$ref": "#/$defs/positionConstraintRoles"}
      }
    },
    "numbering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapters", "sections", "appendices", "figures", "tables"],
      "properties": {
        "chapters": {
          "$ref": "#/$defs/chapterNumbering"
        },
        "sections": {
          "$ref": "#/$defs/sectionNumbering"
        },
        "appendices": {
          "$ref": "#/$defs/appendixNumbering"
        },
        "figures": {
          "$ref": "#/$defs/objectNumbering"
        },
        "tables": {
          "$ref": "#/$defs/objectNumbering"
        }
      }
    },
    "front_matter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts"],
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "heading_role",
              "required",
              "starts_section",
              "page_number_style",
              "show_header"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "minLength": 1,
                "maxLength": 64
              },
              "heading_role": {
                "enum": [
                  "title_zh",
                  "title_en",
                  "front_heading",
                  "abstract_zh",
                  "abstract_en",
                  "keywords"
                ]
              },
              "required": {"type": "boolean"},
              "starts_section": {"type": "boolean"},
              "page_number_style": {"enum": ["none", "upper_roman", "decimal"]},
              "show_header": {"type": "boolean"}
            }
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toc",
        "list_of_figures",
        "list_of_tables",
        "page_number",
        "cross_references"
      ],
      "properties": {
        "toc": {"$ref": "#/$defs/tocField"},
        "list_of_figures": {"$ref": "#/$defs/captionListField"},
        "list_of_tables": {"$ref": "#/$defs/captionListField"},
        "page_number": {
          "type": "object",
          "additionalProperties": false,
          "required": ["front_start", "body_start", "alignment"],
          "properties": {
            "front_start": {"type": "integer", "minimum": 1, "maximum": 100000},
            "body_start": {"type": "integer", "minimum": 1, "maximum": 100000},
            "alignment": {"enum": ["left", "center", "right"]}
          }
        },
        "cross_references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require_existing_target", "mark_dirty_on_write"],
          "properties": {
            "require_existing_target": {"type": "boolean"},
            "mark_dirty_on_write": {"type": "boolean"}
          }
        }
      }
    },
    "headers_footers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front_matter", "body", "appendix", "section_linking"],
      "properties": {
        "front_matter": {"$ref": "#/$defs/headerFooterRegion"},
        "body": {"$ref": "#/$defs/headerFooterRegion"},
        "appendix": {"$ref": "#/$defs/headerFooterRegion"},
        "section_linking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "link_body_headers",
            "link_body_footers",
            "link_appendix_headers",
            "link_appendix_footers"
          ],
          "properties": {
            "link_body_headers": {"type": "boolean"},
            "link_body_footers": {"type": "boolean"},
            "link_appendix_headers": {"type": "boolean"},
            "link_appendix_footers": {"type": "boolean"}
          }
        }
      }
    },
    "figures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_width_mm",
        "alignment",
        "caption_position",
        "caption_keep_with_object",
        "source_note_required_for_non_original"
      ],
      "properties": {
        "max_width_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "alignment": {"enum": ["left", "center", "right"]},
        "caption_position": {"enum": ["above", "below"]},
        "caption_keep_with_object": {"type": "boolean"},
        "source_note_required_for_non_original": {"type": "boolean"}
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption_position",
        "repeat_header",
        "allow_row_split",
        "border_model",
        "continued_table_policy"
      ],
      "properties": {
        "caption_position": {"enum": ["above", "below"]},
        "repeat_header": {"type": "boolean"},
        "allow_row_split": {"type": "boolean"},
        "border_model": {"enum": ["three_line", "grid", "none"]},
        "continued_table_policy": {
          "enum": ["repeat_caption", "continued_label", "split_not_allowed"]
        }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_system",
        "line_spacing_pt",
        "space_before_pt",
        "space_after_pt",
        "hanging_indent_mm"
      ],
      "properties": {
        "citation_system": {"enum": ["numeric", "author_date", "footnote"]},
        "line_spacing_pt": {"type": "number", "exclusiveMinimum": 0, "maximum": 200},
        "space_before_pt": {"type": "number", "minimum": 0, "maximum": 200},
        "space_after_pt": {"type": "number", "minimum": 0, "maximum": 200},
        "hanging_indent_mm": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fictional_values",
        "forbidden_metadata_keys",
        "generic_patterns",
        "unresolved_placeholder_patterns"
      ],
      "properties": {
        "fictional_values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "institution_zh",
            "institution_en",
            "author",
            "student_id",
            "adviser"
          ],
          "properties": {
            "institution_zh": {"type": "string", "minLength": 1, "maxLength": 256},
            "institution_en": {"type": "string", "minLength": 1, "maxLength": 256},
            "author": {"type": "string", "minLength": 1, "maxLength": 256},
            "student_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "adviser": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "forbidden_metadata_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "generic_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "regex", "flags"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 128
              },
              "regex": {"type": "string", "minLength": 1, "maxLength": 2000},
              "flags": {"type": "string", "pattern": "^[imu]*$", "maxLength": 3}
            }
          }
        },
        "unresolved_placeholder_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  },
  "$defs": {
    "styleRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_zh",
        "title_en",
        "front_heading",
        "heading_1",
        "heading_2",
        "heading_3",
        "body",
        "abstract_zh",
        "abstract_en",
        "keywords",
        "figure_caption",
        "table_caption",
        "source_note",
        "table_body",
        "reference",
        "appendix_heading"
      ],
      "properties": {
        "title_zh": {"$ref": "#/$defs/style"},
        "title_en": {"$ref": "#/$defs/style"},
        "front_heading": {"$ref": "#/$defs/style"},
        "heading_1": {"$ref": "#/$defs/style"},
        "heading_2": {"$ref": "#/$defs/style"},
        "heading_3": {"$ref": "#/$defs/style"},
        "body": {"$ref": "#/$defs/style"},
        "abstract_zh": {"$ref": "#/$defs/style"},
        "abstract_en": {"$ref": "#/$defs/style"},
        "keywords": {"$ref": "#/$defs/style"},
        "figure_caption": {"$ref": "#/$defs/style"},
        "table_caption": {"$ref": "#/$defs/style"},
        "source_note": {"$ref": "#/$defs/style"},
        "table_body": {"$ref": "#/$defs/style"},
        "reference": {"$ref": "#/$defs/style"},
        "appendix_heading": {"$ref": "#/$defs/style"}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraph", "run", "word_styles"],
      "properties": {
        "paragraph": {"$ref": "#/$defs/paragraphStyle"},
        "run": {"$ref": "#/$defs/runStyle"},
        "word_styles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "paragraphStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment",
        "line_spacing",
        "space_before_pt",
        "space_after_pt",
        "first_line_chars",
        "left_indent_mm",
        "hanging_indent_mm",
        "keep_with_next",
        "page_break_before"
      ],
      "properties": {
        "alignment": {"enum": ["left", "center", "right", "justify"]},
        "line_spacing": {"$ref": "#/$defs/lineSpacing"},
        "space_before_pt": {"type": "number", "minimum": 0, "maximum": 200},
        "space_after_pt": {"type": "number", "minimum": 0, "maximum": 200},
        "first_line_chars": {"type": "number", "minimum": 0, "maximum": 20},
        "left_indent_mm": {"type": "number", "minimum": 0, "maximum": 100},
        "hanging_indent_mm": {"type": "number", "minimum": 0, "maximum": 100},
        "keep_with_next": {"type": "boolean"},
        "page_break_before": {"type": "boolean"}
      }
    },
    "lineSpacing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value_pt"],
          "properties": {
            "type": {"const": "exact"},
            "value_pt": {"type": "number", "exclusiveMinimum": 0, "maximum": 200}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "multiple"},
            "value": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}
          }
        }
      ]
    },
    "runStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_zh", "font_latin", "size_pt", "bold", "italic"],
      "properties": {
        "font_zh": {"type": "string", "minLength": 1, "maxLength": 256},
        "font_latin": {"type": "string", "minLength": 1, "maxLength": 256},
        "size_pt": {"type": "number", "exclusiveMinimum": 0, "maximum": 200},
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"}
      }
    },
    "textPatternRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_zh",
        "title_en",
        "front_heading",
        "heading_1",
        "heading_2",
        "heading_3",
        "body",
        "abstract_zh",
        "abstract_en",
        "keywords",
        "figure_caption",
        "table_caption",
        "source_note",
        "table_body",
        "reference",
        "appendix_heading"
      ],
      "properties": {
        "title_zh": {"$ref": "#/$defs/textPatterns"},
        "title_en": {"$ref": "#/$defs/textPatterns"},
        "front_heading": {"$ref": "#/$defs/textPatterns"},
        "heading_1": {"$ref": "#/$defs/textPatterns"},
        "heading_2": {"$ref": "#/$defs/textPatterns"},
        "heading_3": {"$ref": "#/$defs/textPatterns"},
        "body": {"$ref": "#/$defs/textPatterns"},
        "abstract_zh": {"$ref": "#/$defs/textPatterns"},
        "abstract_en": {"$ref": "#/$defs/textPatterns"},
        "keywords": {"$ref": "#/$defs/textPatterns"},
        "figure_caption": {"$ref": "#/$defs/textPatterns"},
        "table_caption": {"$ref": "#/$defs/textPatterns"},
        "source_note": {"$ref": "#/$defs/textPatterns"},
        "table_body": {"$ref": "#/$defs/textPatterns"},
        "reference": {"$ref": "#/$defs/textPatterns"},
        "appendix_heading": {"$ref": "#/$defs/textPatterns"}
      }
    },
    "textPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "flags", "priority"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1, "maxLength": 2000},
          "flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["ascii", "ignore_case", "multiline", "unicode"]}
          },
          "priority": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      }
    },
    "positionConstraintRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_zh",
        "title_en",
        "front_heading",
        "heading_1",
        "heading_2",
        "heading_3",
        "body",
        "abstract_zh",
        "abstract_en",
        "keywords",
        "figure_caption",
        "table_caption",
        "source_note",
        "table_body",
        "reference",
        "appendix_heading"
      ],
      "properties": {
        "title_zh": {"$ref": "#/$defs/positionConstraints"},
        "title_en": {"$ref": "#/$defs/positionConstraints"},
        "front_heading": {"$ref": "#/$defs/positionConstraints"},
        "heading_1": {"$ref": "#/$defs/positionConstraints"},
        "heading_2": {"$ref": "#/$defs/positionConstraints"},
        "heading_3": {"$ref": "#/$defs/positionConstraints"},
        "body": {"$ref": "#/$defs/positionConstraints"},
        "abstract_zh": {"$ref": "#/$defs/positionConstraints"},
        "abstract_en": {"$ref": "#/$defs/positionConstraints"},
        "keywords": {"$ref": "#/$defs/positionConstraints"},
        "figure_caption": {"$ref": "#/$defs/positionConstraints"},
        "table_caption": {"$ref": "#/$defs/positionConstraints"},
        "source_note": {"$ref": "#/$defs/positionConstraints"},
        "table_body": {"$ref": "#/$defs/positionConstraints"},
        "reference": {"$ref": "#/$defs/positionConstraints"},
        "appendix_heading": {"$ref": "#/$defs/positionConstraints"}
      }
    },
    "positionConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "min_index",
          "max_index",
          "first_page_only"
        ],
        "properties": {
          "section": {
            "enum": [
              "title_page",
              "front_matter",
              "body",
              "references",
              "appendix",
              "any"
            ]
          },
          "min_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "max_index": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 1000000
          },
          "first_page_only": {"type": "boolean"}
        }
      }
    },
    "chapterNumbering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "separator", "restart_scope"],
      "properties": {
        "format": {"const": "chinese_chapter"},
        "separator": {"type": "string", "maxLength": 10},
        "restart_scope": {"enum": ["document", "chapter", "appendix"]}
      }
    },
    "sectionNumbering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "separator", "restart_scope"],
      "properties": {
        "format": {"const": "decimal"},
        "separator": {"type": "string", "maxLength": 10},
        "restart_scope": {"enum": ["document", "chapter", "appendix"]}
      }
    },
    "appendixNumbering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "separator", "restart_scope"],
      "properties": {
        "format": {"const": "upper_alpha"},
        "separator": {"type": "string", "maxLength": 10},
        "restart_scope": {"enum": ["document", "chapter", "appendix"]}
      }
    },
    "objectNumbering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "separator", "restart_scope"],
      "properties": {
        "format": {"const": "chapter_sequence"},
        "separator": {"type": "string", "maxLength": 10},
        "restart_scope": {"enum": ["document", "chapter", "appendix"]}
      }
    },
    "tocField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "field_code", "levels"],
      "properties": {
        "required": {"type": "boolean"},
        "field_code": {"type": "string", "minLength": 1, "maxLength": 1000},
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 1, "maximum": 9},
            "max": {"type": "integer", "minimum": 1, "maximum": 9}
          }
        }
      }
    },
    "captionListField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "field_code", "levels"],
      "properties": {
        "required": {"type": "boolean"},
        "field_code": {"type": "string", "minLength": 1, "maxLength": 1000},
        "levels": {"type": "null"}
      }
    },
    "headerFooterRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_enabled",
        "header_source",
        "header_style_role",
        "page_number_enabled",
        "page_number_style",
        "page_number_alignment"
      ],
      "properties": {
        "header_enabled": {"type": "boolean"},
        "header_source": {
          "enum": [
            "none",
            "fixed_text",
            "current_front_heading",
            "current_heading_1",
            "current_appendix_heading"
          ]
        },
        "header_style_role": {
          "enum": [
            "front_heading",
            "heading_1",
            "appendix_heading",
            "body"
          ]
        },
        "header_text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "page_number_enabled": {"type": "boolean"},
        "page_number_style": {"enum": ["none", "upper_roman", "decimal"]},
        "page_number_alignment": {"enum": ["left", "center", "right"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"header_source": {"const": "fixed_text"}},
            "required": ["header_source"]
          },
          "then": {"required": ["header_text"]}
        },
        {
          "if": {
            "properties": {"header_enabled": {"const": false}},
            "required": ["header_enabled"]
          },
          "then": {"properties": {"header_source": {"const": "none"}}}
        }
      ]
    }
  }
}
