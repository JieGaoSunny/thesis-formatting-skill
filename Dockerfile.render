# syntax=docker/dockerfile:1.7
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ARG DEBIAN_SNAPSHOT=20250203T000000Z
ARG FONT_INPUTS_JSON='["Liberation Serif","Noto Serif CJK SC"]'
ARG SOURCE_COMMIT
ARG UV_VERSION=0.6.17

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8 \
    TZ=UTC \
    PYTHONHASHSEED=0 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm main" \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ bookworm-security main" \
      > /etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      fontconfig \
      fonts-liberation2 \
      fonts-noto-cjk \
      libreoffice-writer \
      locales \
      poppler-utils \
    && sed -i 's/^# *zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && fc-cache -f \
    && test "$(fc-match 'Noto Serif CJK SC' --format='%{family}\n' | head -1)" = "Noto Serif CJK SC" \
    && fc-match 'Liberation Serif' --format='%{family}\n' | head -1 | grep -Fx 'Liberation Serif' \
    && mkdir -p /usr/local/share/thesis-format \
    && soffice --version | tee /usr/local/share/thesis-format/soffice-version.txt \
    && test -s /usr/local/share/thesis-format/soffice-version.txt \
    && rm -rf /var/lib/apt/lists/*

RUN <<'EOF'
set -eu
case "${SOURCE_COMMIT}" in
  *[!0-9a-fA-F]*|'') echo "SOURCE_COMMIT must be exactly 40 hexadecimal characters" >&2; exit 1 ;;
esac
test "${#SOURCE_COMMIT}" -eq 40 || {
  echo "SOURCE_COMMIT must be exactly 40 hexadecimal characters" >&2
  exit 1
}
export SOURCE_COMMIT DEBIAN_SNAPSHOT FONT_INPUTS_JSON
python - <<'PY'
import hashlib
import json
import os
import pathlib
import subprocess

queries = json.loads(os.environ["FONT_INPUTS_JSON"])
if not isinstance(queries, list) or not queries or not all(
    isinstance(query, str) and query for query in queries
):
    raise SystemExit("FONT_INPUTS_JSON must be a nonempty JSON string array")

observations = []
for query in queries:
    output = subprocess.check_output(
        [
            "fc-match",
            query,
            "--format=%{family}\t%{style}\t%{file}\n",
        ],
        text=True,
    ).rstrip("\n")
    fields = output.split("\t")
    if len(fields) != 3 or not all(fields):
        raise SystemExit(f"invalid font observation for {query!r}")
    observations.append(
        {
            "query": query,
            "family": fields[0],
            "style": fields[1],
            "file": fields[2],
        }
    )

version = pathlib.Path(
    "/usr/local/share/thesis-format/soffice-version.txt"
).read_text(encoding="utf-8").strip()
font_payload = (
    json.dumps(
        observations,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    )
    + "\n"
)
marker = {
    "schema_version": "1.0",
    "source_commit": os.environ["SOURCE_COMMIT"].lower(),
    "debian_snapshot": os.environ["DEBIAN_SNAPSHOT"],
    "font_queries": queries,
    "locale": os.environ["LANG"],
    "timezone": os.environ["TZ"],
    "soffice_version_sha256": hashlib.sha256(
        version.encode("utf-8")
    ).hexdigest(),
    "font_input_fingerprint": hashlib.sha256(
        font_payload.encode("utf-8")
    ).hexdigest(),
}
path = pathlib.Path(
    "/usr/local/share/thesis-format/canonical-container.json"
)
path.write_text(
    json.dumps(marker, separators=(",", ":"), sort_keys=True) + "\n",
    encoding="utf-8",
)
PY
chown root:root /usr/local/share/thesis-format/canonical-container.json
chmod 0444 /usr/local/share/thesis-format/canonical-container.json
EOF

WORKDIR /app

RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}"

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-extras --no-install-project

COPY src ./src
COPY rules ./rules
COPY templates ./templates
RUN uv sync --frozen --all-extras \
    && test "$(soffice --version)" = "$(cat /usr/local/share/thesis-format/soffice-version.txt)" \
    && pdftoppm -v 2>&1 | head -1 \
    && uv run python -c "import pikepdf, pymupdf, thesis_format.render"

ENTRYPOINT ["uv", "run", "thesis-format"]
